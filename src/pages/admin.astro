---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminDashboard from '../components/AdminDashboard';
---

<BaseLayout
  title="Zarlino Audio Admin"
  description="Private Zarlino Audio dashboard."
  canonicalURL="https://zarlinoaudio.com/admin"
  noindex
>
  <main class="relative z-[1] bg-[#050505] min-h-screen pt-24 pb-24 px-6 md:px-10">
    <div class="max-w-[960px] mx-auto">
      <AdminDashboard client:load />
    </div>
  </main>
</BaseLayout>
