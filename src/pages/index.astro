---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/HomePage';
import { PRODUCTS, SITE } from '../config/products';
---

<BaseLayout
  title="Zarlino Audio — Precision Audio Processing Plugins: ZTame, ZScorch"
  description="Zarlino Audio builds precision audio tools for mixing and mastering. ZTame — automatic resonance suppression. ZScorch — adaptive harmonic processing. Windows VST3."
  canonicalURL="https://zarlinoaudio.com/"
  schemaType="website"
>
  <!-- Organization Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Zarlino Audio",
    "url": "https://zarlinoaudio.com",
    "logo": "https://zarlinoaudio.com/images/zarlino-logo.svg",
    "description": "Zarlino Audio makes precision audio processing plugins for mixing and mastering. Creators of ZTame and ZScorch.",
    "sameAs": [
      "https://twitter.com/zarlinoaudio",
      "https://instagram.com/zarlinoaudio",
      "https://youtube.com/@zarlinoaudio"
    ]
  })} />

  <!-- WebSite Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Zarlino Audio",
    "url": "https://zarlinoaudio.com",
    "description": "Precision audio processing plugins for mixing, mastering, and vocal production.",
    "publisher": {
      "@type": "Organization",
      "name": "Zarlino Audio",
      "url": "https://zarlinoaudio.com"
    }
  })} />

  <!-- ItemList of Products (prices from the central product config) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Zarlino Audio Plugin Lineup",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "ZTame",
        "url": `${SITE.url}${PRODUCTS.ztame.slug}`,
        "image": `${SITE.url}${PRODUCTS.ztame.image}`,
        "description": PRODUCTS.ztame.description,
        "offers": {
          "@type": "Offer",
          "price": String(PRODUCTS.ztame.priceUsd),
          "priceCurrency": "USD",
          "availability": "https://schema.org/InStock"
        }
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "ZScorch",
        "url": `${SITE.url}${PRODUCTS.zscorch.slug}`,
        "image": `${SITE.url}${PRODUCTS.zscorch.image}`,
        "description": PRODUCTS.zscorch.description,
        "offers": {
          "@type": "Offer",
          "price": String(PRODUCTS.zscorch.priceUsd),
          "priceCurrency": "USD",
          "availability": "https://schema.org/InStock"
        }
      }
    ]
  })} />

  <HomePage client:load />
</BaseLayout>
