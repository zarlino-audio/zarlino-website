---
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateForm from '../components/AffiliateForm';
---

<BaseLayout
  title="Affiliate Program — Zarlino Audio"
  description="Join the Zarlino Audio affiliate program. Promote ZTame and ZScorch and earn a share of sales. Apply in under a minute."
  canonicalURL="https://zarlinoaudio.com/affiliates"
  schemaType="website"
>
  <main class="relative z-[1] bg-[#050505] min-h-screen pt-24 pb-24 px-6 md:px-10">
    <div class="max-w-[820px] mx-auto">
      <nav class="mb-8 font-['Inter'] text-[13px] text-[#64748B]">
        <a href="/" class="hover:text-white transition-colors">Zarlino Audio</a>
        <span class="mx-2">/</span>
        <span class="text-[#94A3B8]">Affiliate Program</span>
      </nav>

      <span class="inline-block font-['IBM_Plex_Mono'] text-[11px] uppercase tracking-[0.1em] text-[#00D4FF] border border-[rgba(0,212,255,0.35)] rounded-full px-3 py-1 mb-4">
        Earn with Zarlino
      </span>

      <h1 class="font-['Space_Grotesk'] font-semibold text-white" style="font-size: clamp(34px, 5vw, 56px); line-height: 1.1; letter-spacing: -0.03em;">
        Become an affiliate
      </h1>

      <p class="mt-4 font-['Inter'] text-[17px] text-[#94A3B8] leading-[1.7] max-w-[650px]">
        Love ZTame and ZScorch? Share them with your audience and earn a share of
        every sale you drive. Whether you make tutorials, write about mixing, or
        run a newsletter, our program is built to be simple to join and honest.
      </p>

      <div class="mt-4 font-['Inter'] text-[15px] text-[#94A3B8] leading-[1.7] max-w-[650px]">
        <span class="inline-flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#00D4FF]" /> 25% commission on every sale you refer.</span><br />
        <span class="inline-flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#00D4FF]" /> A unique referral link you can track.</span><br />
        <span class="inline-flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#00D4FF]" /> No minimums beyond being approved.</span>
      </div>

      <section class="mt-10">
        <AffiliateForm client:load />
      </section>
    </div>
  </main>
</BaseLayout>
