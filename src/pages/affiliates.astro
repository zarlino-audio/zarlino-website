---
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateEnrolForm from '../components/AffiliateEnrolForm';
---

<BaseLayout
  title="Affiliate Program — Zarlino Audio"
  description="Earn commissions promoting Zarlino Audio's precision mixing and mastering plugins. Apply to become a Zarlino affiliate."
  canonicalURL="https://zarlinoaudio.com/affiliates"
  schemaType="website"
>
  <main class="relative z-[1] bg-[#050505] min-h-screen pt-24 pb-24 px-6 md:px-10">
    <div class="max-w-[820px] mx-auto">
      <!-- Breadcrumb -->
      <nav class="mb-8 font-['Inter'] text-[13px] text-[#64748B]">
        <a href="/" class="hover:text-white transition-colors">Zarlino Audio</a>
        <span class="mx-2">/</span>
        <span class="text-[#94A3B8]">Affiliate program</span>
      </nav>

      <!-- BETA badge -->
      <span class="inline-block font-['IBM_Plex_Mono'] text-[11px] uppercase tracking-[0.1em] text-[#FBBF24] border border-[rgba(251,191,36,0.35)] rounded-full px-3 py-1 mb-4">
        Now enrolling
      </span>

      <!-- H1 -->
      <h1 class="font-['Space_Grotesk'] font-semibold text-white" style="font-size: clamp(34px, 5vw, 56px); line-height: 1.1; letter-spacing: -0.03em;">
        Zarlino Affiliate Program
      </h1>

      <!-- Intro -->
      <p class="mt-4 font-['Inter'] text-[17px] text-[#94A3B8] leading-[1.7] max-w-[650px]">
        Zarlino Audio builds precision mixing and mastering plugins — <strong class="text-white">ZTame</strong>
        (automatic resonance suppression) and <strong class="text-white">ZScorch</strong> (adaptive harmonic
        processing). We're opening our affiliate program to educators, creators, and trusted audio voices.
      </p>

      <div class="mt-6 flex flex-col gap-3 font-['Inter'] text-[15px] text-[#94A3B8] leading-[1.7] max-w-[650px]">
        <span class="inline-flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[#00D4FF]" />
          Earn a commission on sales you refer through your unique affiliate link.
        </span>
        <span class="inline-flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[#00D4FF]" />
          Perfect for mixing/mastering educators, YouTube channels, blogs, and communities.
        </span>
        <span class="inline-flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[#00D4FF]" />
          No cost to join. We review every application.
        </span>
      </div>

      <!-- Form -->
      <section class="mt-10">
        <AffiliateEnrolForm client:load />
      </section>

      <!-- Note on timing -->
      <section class="mt-6 font-['Inter'] text-[14px] text-[#94A3B8]">
        Questions? Write to{' '}
        <a href="mailto:support@zarlinoaudio.com" class="text-[#00D4FF] hover:underline">
          support@zarlinoaudio.com
        </a>
        . By applying you agree to be contacted about the program.
      </section>
    </div>
  </main>
</BaseLayout>
