---
/**
 * Internal artboard (noindex, excluded from sitemap) used to render the
 * Vee Properties OG share image: 1200x630. Not part of the user journey.
 */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex,nofollow" />
    <title>OG artboard — Vee Properties</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Manrope:wght@400;600;700;800&display=swap"
    />
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html,
      body {
        width: 1200px;
        height: 630px;
        overflow: hidden;
      }

      body {
        font-family: 'Manrope', system-ui, sans-serif;
        background: linear-gradient(150deg, #090f0b 0%, #0d1d14 55%, #12271c 100%);
        color: #f5f0e6;
        position: relative;
      }

      .glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
      }

      .glow--a {
        width: 460px;
        height: 460px;
        top: -170px;
        right: 220px;
        background: radial-gradient(circle, rgba(46, 107, 78, 0.55), transparent 68%);
      }

      .glow--b {
        width: 380px;
        height: 380px;
        bottom: -180px;
        left: -120px;
        background: radial-gradient(circle, rgba(198, 167, 94, 0.28), transparent 70%);
      }

      .artboard {
        position: relative;
        width: 1200px;
        height: 630px;
        padding: 54px 60px;
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
        gap: 44px;
        align-items: center;
      }

      .brand {
        position: absolute;
        top: 44px;
        left: 60px;
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .brand strong {
        display: block;
        font-family: 'Fraunces', Georgia, serif;
        font-size: 25px;
        font-weight: 500;
        letter-spacing: 0.01em;
      }

      .brand em {
        display: block;
        font-style: normal;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: #e4c87f;
        margin-top: 4px;
      }

      .copy {
        padding-top: 66px;
        display: grid;
        gap: 22px;
        justify-items: start;
      }

      .kicker {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-size: 12.5px;
        font-weight: 800;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: #c6a75e;
      }

      .kicker::before {
        content: '';
        width: 34px;
        height: 1px;
        background: currentColor;
      }

      h1 {
        font-family: 'Fraunces', Georgia, serif;
        font-weight: 500;
        font-size: 66px;
        line-height: 1.02;
        letter-spacing: -0.015em;
      }

      h1 em {
        font-style: italic;
        color: #e4c87f;
      }

      .sub {
        font-size: 19px;
        line-height: 1.55;
        color: rgba(245, 240, 230, 0.78);
        max-width: 46ch;
      }

      .url {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-top: 6px;
        padding: 12px 22px;
        border-radius: 999px;
        border: 1px solid rgba(228, 200, 127, 0.35);
        background: rgba(228, 200, 127, 0.08);
        font-size: 17px;
        font-weight: 700;
        color: #e4c87f;
      }

      .shot {
        position: relative;
      }

      .shot::before {
        content: '';
        position: absolute;
        inset: 0;
        transform: translate(16px, 16px);
        border: 1px solid rgba(228, 200, 127, 0.4);
        border-radius: 24px;
      }

      .shot img {
        display: block;
        width: 100%;
        height: 430px;
        object-fit: cover;
        object-position: center 62%;
        border-radius: 24px;
        border: 1px solid rgba(228, 200, 127, 0.3);
        box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.85);
      }

      .chip {
        position: absolute;
        left: 18px;
        bottom: 18px;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 20px;
        border-radius: 999px;
        background: rgba(9, 15, 11, 0.78);
        border: 1px solid rgba(228, 200, 127, 0.34);
        font-size: 16px;
        font-weight: 700;
      }

      .chip i {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #53d97f;
      }

      .chip span {
        color: #e4c87f;
      }
    </style>
  </head>
  <body>
    <span class="glow glow--a"></span>
    <span class="glow glow--b"></span>

    <div class="artboard">
      <div class="brand">
        <svg viewBox="0 0 64 64" width="52" height="52" aria-hidden="true">
          <rect width="64" height="64" rx="15" fill="#0B140F"></rect>
          <path
            d="M15 18 L32 47 L49 18"
            fill="none"
            stroke="#E4C87F"
            stroke-width="7"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="M15 53 H49"
            stroke="#C6A75E"
            stroke-width="2.5"
            stroke-linecap="round"
            opacity="0.8"></path>
        </svg>
        <span>
          <strong>Vee Properties</strong>
          <em>Real estate · Accra</em>
        </span>
      </div>

      <div class="copy">
        <p class="kicker">Homes · Apartments · Investments</p>
        <h1>The right address,<br /><em>chosen properly.</em></h1>
        <p class="sub">
          Verified homes across Accra's best neighbourhoods — real prices, honest advice,
          a human reply within 15 minutes.
        </p>
        <span class="url">zarlinoaudio.com/real-estate</span>
      </div>

      <div class="shot">
        <img src="/images/vee/hero-atrium.jpg" alt="" />
        <span class="chip"><i></i>East Legon · <span>$320,000</span></span>
      </div>
    </div>
  </body>
</html>
