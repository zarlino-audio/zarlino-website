---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeedbackForm from '../components/FeedbackForm';
---

<BaseLayout
  title="Report a Bug or Suggest a Feature — Zarlino Audio"
  description="Report bugs, crashes, and glitches in ZTame and ZScorch, or suggest features for future Zarlino Audio releases."
  canonicalURL="https://zarlinoaudio.com/report"
  schemaType="website"
>
  <main class="relative z-[1] bg-[#050505] min-h-screen pt-24 pb-24 px-6 md:px-10">
    <div class="max-w-[820px] mx-auto">
      <!-- Breadcrumb -->
      <nav class="mb-8 font-['Inter'] text-[13px] text-[#64748B]">
        <a href="/" class="hover:text-white transition-colors">Zarlino Audio</a>
        <span class="mx-2">/</span>
        <span class="text-[#94A3B8]">Report a Bug or Suggestion</span>
      </nav>

      <!-- badge -->
      <span class="inline-block font-['IBM_Plex_Mono'] text-[11px] uppercase tracking-[0.1em] text-[#00D4FF] border border-[rgba(0,212,255,0.35)] rounded-full px-3 py-1 mb-4">
        v1.0 — Feedback
      </span>

      <!-- H1 -->
      <h1 class="font-['Space_Grotesk'] font-semibold text-white" style="font-size: clamp(34px, 5vw, 56px); line-height: 1.1; letter-spacing: -0.03em;">
        Report a Bug or Suggestion
      </h1>

      <!-- Intro -->
      <p class="mt-4 font-['Inter'] text-[17px] text-[#94A3B8] leading-[1.7] max-w-[650px]">
        Found a crash, a zipper, or a glitch in <strong class="text-white">ZTame</strong> or
        <strong class="text-white">ZScorch</strong>? Your reports help us ship better updates and shape
        future releases. Every submission lands in a public thread the team reviews regularly.
      </p>

      <div class="mt-4 font-['Inter'] text-[15px] text-[#94A3B8] leading-[1.7] max-w-[650px]">
        <span class="inline-flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[#00D4FF]" />
          Found a crash, glitch, or zipper noise? Report it as a bug.
        </span>
        <br />
        <span class="inline-flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[#00D4FF]" />
          Want a feature for a future release? Send a suggestion.
        </span>
      </div>

      <!-- Form -->
      <section class="mt-10">
        <FeedbackForm client:load />
      </section>

      <!-- Tips -->
      <section class="mt-10 rounded-2xl border border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.03)] p-6 md:p-8">
        <h2 class="font-['Space_Grotesk'] font-semibold text-white text-[20px]">Tips for a great bug report</h2>
        <ul class="mt-4 flex flex-col gap-3 font-['Inter'] text-[14px] text-[#94A3B8] leading-[1.7]">
          <li>
            <strong class="text-[#CBD5E1]">Tell us what you did</strong> — the exact steps that triggered the
            issue, and whether it happens every time or only sometimes.
          </li>
          <li>
            <strong class="text-[#CBD5E1]">Include your setup</strong> — DAW name and version, Windows version
            (e.g. Windows 11 23H2), audio interface, and session sample rate.
          </li>
          <li>
            <strong class="text-[#CBD5E1]">Mention the plugin version</strong> — currently ZTame 1.0.0.
          </li>
          <li>
            <strong class="text-[#CBD5E1]">Audio examples help</strong> — a short clip before/after, or a saved
            project, can make the difference. If you can share one, mention it and we may ask for a link.
          </li>
        </ul>
      </section>

      <!-- Email fallback -->
      <section class="mt-6 font-['Inter'] text-[14px] text-[#94A3B8]">
        Prefer email? Write to{' '}
        <a href="mailto:support@zarlinoaudio.com" class="text-[#00D4FF] hover:underline">
          support@zarlinoaudio.com
        </a>
        . For licensing questions, visit the{' '}
        <a href="/plugins/ztame#license" class="text-[#00D4FF] hover:underline">ZTame page</a>.
      </section>
    </div>
  </main>
</BaseLayout>
