---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Zarlino Essentials — ZTame, ZScorch & ZVocals Bundle by Zarlino Audio"
  description="Zarlino Essentials bundles all three Zarlino Audio plugins — ZTame, ZScorch, and ZVocals — into one complete precision audio processing toolkit. $120 after the public beta (free until August 25, 2026). Windows VST3."
  canonicalURL="https://zarlinoaudio.com/plugins/essentials"
  schemaType="product"
>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Zarlino Essentials",
    "description": "Bundle of all three Zarlino Audio plugins: ZTame dynamic resonance suppressor, ZScorch adaptive harmonic processor, and ZVocals vocal channel strip. $120 after the public beta, or $177 when purchased separately.",
    "brand": {
      "@type": "Brand",
      "name": "Zarlino Audio"
    },
    "offers": {
      "@type": "Offer",
      "price": "0.00",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
      "priceValidUntil": "2026-08-25",
      "description": "Free during public beta (until August 25, 2026). Regular price $120 after the beta — a $57 saving versus buying ZTame, ZScorch, and ZVocals separately.",
      "url": "https://zarlinoaudio.com/plugins/essentials"
    },
    "isRelatedTo": [
      { "@type": "SoftwareApplication", "name": "ZTame", "url": "https://zarlinoaudio.com/plugins/ztame" },
      { "@type": "SoftwareApplication", "name": "ZScorch", "url": "https://zarlinoaudio.com/plugins/zscorch" },
      { "@type": "SoftwareApplication", "name": "ZVocals", "url": "https://zarlinoaudio.com/plugins/zvocals" }
    ]
  })} />

  <!-- BreadcrumbList Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://zarlinoaudio.com/" },
      { "@type": "ListItem", "position": 2, "name": "Plugins", "item": "https://zarlinoaudio.com/#plugins" },
      { "@type": "ListItem", "position": 3, "name": "Zarlino Essentials", "item": "https://zarlinoaudio.com/plugins/essentials" }
    ]
  })} />

  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is included in Zarlino Essentials?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Zarlino Essentials bundles all three Zarlino Audio plugins: ZTame (dynamic resonance suppressor), ZScorch (adaptive harmonic processor), and ZVocals (vocal channel strip)."
        }
      },
      {
        "@type": "Question",
        "name": "How much does Zarlino Essentials cost?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Zarlino Essentials is free during the public beta, which runs until August 25, 2026. After the beta, the bundle is $120 — a $57 saving versus buying ZTame ($49), ZScorch ($79), and ZVocals ($49) separately."
        }
      },
      {
        "@type": "Question",
        "name": "Do the plugins in Zarlino Essentials run on Windows?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. ZTame and ZScorch are Windows VST3 plus a standalone app, and ZVocals is Windows VST3 plus a standalone app. All require Windows 10 22H2 or later (64-bit)."
        }
      },
      {
        "@type": "Question",
        "name": "Is there a free trial for Zarlino Essentials?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Zarlino Essentials is free during the public beta until August 25, 2026. After the beta, a license key is required for continued use."
        }
      }
    ]
  })} />

  <main class="relative z-[1] bg-[#050505] min-h-screen pt-24 pb-24 px-6 md:px-10">
    <div class="max-w-[900px] mx-auto">
      <!-- Breadcrumb -->
      <nav class="mb-8 font-['Inter'] text-[13px] text-[#64748B]">
        <a href="/" class="hover:text-white transition-colors">Zarlino Audio</a>
        <span class="mx-2">/</span>
        <a href="/#plugins" class="hover:text-white transition-colors">Plugins</a>
        <span class="mx-2">/</span>
        <span class="text-[#94A3B8]">Zarlino Essentials</span>
      </nav>

      <div class="flex items-center gap-2 mb-4">
        <span class="inline-block font-['IBM_Plex_Mono'] text-[11px] uppercase tracking-[0.1em] text-[#00D4FF] border border-[rgba(0,212,255,0.3)] rounded-full px-3 py-1">
          Complete Toolkit Bundle
        </span>
        <span class="inline-block font-['IBM_Plex_Mono'] text-[11px] uppercase tracking-[0.1em] text-[#FBBF24] border border-[rgba(251,191,36,0.35)] rounded-full px-3 py-1">
          Public Beta
        </span>
      </div>

      <!-- H1 -->
      <h1 class="font-['Space_Grotesk'] font-semibold text-white" style="font-size: clamp(40px, 5vw, 64px); line-height: 1.1; letter-spacing: -0.03em;">
        Zarlino Essentials
      </h1>

      <!-- Tagline -->
      <p class="mt-4 font-['Inter'] text-[18px] text-[#94A3B8] leading-[1.7] max-w-[650px]">
        All three Zarlino Audio plugins in one bundle — resonance suppression, harmonic processing, and vocal channel processing — for a complete precision audio processing toolkit.
      </p>

      <!-- Pricing + CTA -->
      <div class="mt-8 flex items-center gap-4 flex-wrap">
        <span class="font-['Space_Grotesk'] font-semibold text-[36px] text-white">FREE</span>
        <span class="font-['Inter'] text-[14px] text-[#94A3B8]">
          <s class="text-[#64748B]">$120</s>&nbsp;&nbsp;Free in beta until
          <strong class="text-white">August 25, 2026</strong>
        </span>
        <a href="/plugins/ztame#download" class="inline-flex items-center bg-[#00D4FF] text-[#050505] rounded-lg px-8 py-[14px] font-['Inter'] font-medium text-[15px] hover:bg-[#33DDFF] transition-colors duration-300">
          Get All Three Plugins
        </a>
      </div>

      <!-- Bundle Value -->
      <section class="mt-14">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">Why Zarlino Essentials</h2>
        <div class="font-['Inter'] text-[16px] text-[#94A3B8] leading-[1.8] space-y-4">
          <p>
            Zarlino Essentials includes every Zarlino Audio plugin in one bundle at a discounted price. After the public beta, ZTame ($49), ZScorch ($79), and ZVocals ($49) total $177 — the bundle saves you $57.
          </p>
          <p>
            Each plugin covers a distinct stage of the production chain, so the bundle works as a coherent toolkit rather than three overlapping tools. During the public beta, the entire bundle is free until August 25, 2026.
          </p>
        </div>
      </section>

      <!-- Included Plugins -->
      <section class="mt-14">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">What's Included</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <a href="/plugins/ztame" class="group rounded-xl border border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.03)] p-6 hover:border-[rgba(0,212,255,0.4)] hover:bg-[rgba(0,212,255,0.05)] transition-all duration-300">
            <h3 class="font-['Space_Grotesk'] font-semibold text-white text-[18px]">ZTame</h3>
            <p class="mt-2 font-['Inter'] text-[13px] text-[#94A3B8] leading-[1.6]">Dynamic resonance suppressor — FFT-based automatic reduction of harsh frequencies and ringing.</p>
            <span class="mt-4 inline-block font-['Inter'] font-medium text-[14px] text-[#00D4FF] group-hover:underline">View ZTame →</span>
          </a>
          <a href="/plugins/zscorch" class="group rounded-xl border border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.03)] p-6 hover:border-[rgba(0,212,255,0.4)] hover:bg-[rgba(0,212,255,0.05)] transition-all duration-300">
            <h3 class="font-['Space_Grotesk'] font-semibold text-white text-[18px]">ZScorch</h3>
            <p class="mt-2 font-['Inter'] text-[13px] text-[#94A3B8] leading-[1.6]">Adaptive harmonic processor — multiband saturation across six topologies with Lift, Character, and Mix macros.</p>
            <span class="mt-4 inline-block font-['Inter'] font-medium text-[14px] text-[#00D4FF] group-hover:underline">View ZScorch →</span>
          </a>
          <a href="/plugins/zvocals" class="group rounded-xl border border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.03)] p-6 hover:border-[rgba(0,212,255,0.4)] hover:bg-[rgba(0,212,255,0.05)] transition-all duration-300">
            <h3 class="font-['Space_Grotesk'] font-semibold text-white text-[18px]">ZVocals</h3>
            <p class="mt-2 font-['Inter'] text-[13px] text-[#94A3B8] leading-[1.6]">Vocal channel strip — SSL EQ, FET, multiband, opto, and de-esser driven by TONE, PUNCH, and BODY macros.</p>
            <span class="mt-4 inline-block font-['Inter'] font-medium text-[14px] text-[#00D4FF] group-hover:underline">View ZVocals →</span>
          </a>
        </div>
      </section>

      <!-- Pricing Details -->
      <section class="mt-14" id="pricing">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">Bundle Pricing</h2>
        <div class="rounded-xl border border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.03)] p-6 overflow-hidden">
          <table class="w-full font-['Inter'] text-[15px] text-[#94A3B8]">
            <thead>
              <tr class="text-left font-['IBM_Plex_Mono'] text-[11px] uppercase tracking-[0.1em] text-[#64748B]">
                <th class="pb-3">Product</th>
                <th class="pb-3 text-right">Price After Beta</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-t border-[rgba(255,255,255,0.06)]">
                <td class="py-3">ZTame</td>
                <td class="py-3 text-right text-white">$49</td>
              </tr>
              <tr class="border-t border-[rgba(255,255,255,0.06)]">
                <td class="py-3">ZScorch</td>
                <td class="py-3 text-right text-white">$79</td>
              </tr>
              <tr class="border-t border-[rgba(255,255,255,0.06)]">
                <td class="py-3">ZVocals</td>
                <td class="py-3 text-right text-white">$49</td>
              </tr>
              <tr class="border-t border-[rgba(255,255,255,0.06)]">
                <td class="py-3">Separately</td>
                <td class="py-3 text-right text-[#64748B] line-through">$177</td>
              </tr>
              <tr class="border-t border-[rgba(0,212,255,0.3)] bg-[rgba(0,212,255,0.05)]">
                <td class="py-3 font-medium text-white">Zarlino Essentials bundle</td>
                <td class="py-3 text-right font-semibold text-[#00D4FF]">$120</td>
              </tr>
            </tbody>
          </table>
          <p class="mt-4 font-['Inter'] text-[13px] text-[#64748B]">
            All plugins are free during the public beta until August 25, 2026.
          </p>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
