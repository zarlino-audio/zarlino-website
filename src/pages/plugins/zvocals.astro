---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Download } from 'lucide-react';
---

<BaseLayout
  title="ZVocals — Three-Macro Vocal Channel Strip by Zarlino Audio"
  description="ZVocals is Zarlino Audio's three-macro vocal processor. TONE, PUNCH, and BODY drive a five-stage chain — SSL EQ, FET compression, 4-band multiband, opto compression, and an always-adaptive de-esser. A professional vocal chain in three knobs. Windows VST3."
  canonicalURL="https://zarlinoaudio.com/plugins/zvocals"
  schemaType="product"
>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "ZVocals",
    "applicationCategory": "MusicApplication",
    "operatingSystem": "Windows 10 22H2 or later",
    "description": "Three-macro vocal channel strip: TONE, PUNCH, and BODY drive a five-stage chain with SSL EQ, FET compression, 4-band multiband dynamics, opto compression, and an always-content-adaptive de-esser. Zero-latency minimum-phase processing.",
    "offers": {
      "@type": "Offer",
      "price": "149.00",
      "priceCurrency": "USD",
      "availability": "https://schema.org/PreOrder",
      "description": "Pre-order pricing. A 14-day fully functional trial is built into the plugin.",
      "url": "https://zarlinoaudio.com/plugins/zvocals"
    },
    "author": {
      "@type": "Organization",
      "name": "Zarlino Audio"
    },
    "version": "0.1.0",
    "sku": "ZA-ZVOCALS-010"
  })} />

  <!-- BreadcrumbList Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://zarlinoaudio.com/" },
      { "@type": "ListItem", "position": 2, "name": "Plugins", "item": "https://zarlinoaudio.com/#plugins" },
      { "@type": "ListItem", "position": 3, "name": "ZVocals", "item": "https://zarlinoaudio.com/plugins/zvocals" }
    ]
  })} />

  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do the three ZVocals macros work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Each macro drives a distinct mechanism. TONE steers spectral balance (Warm to Bright) across the SSL EQ and the whole chain. PUNCH governs the transient-versus-sustain balance through the FET compressor and multiband. BODY controls perceived density and weight via low-end EQ, FET sustain, and opto glue. The de-esser stays content-adaptive and is never driven harder by any macro."
        }
      },
      {
        "@type": "Question",
        "name": "What is the ZVocals signal chain?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "ZVocals runs five stages in series: SSL-style EQ, FET-style compression, 4-band multiband dynamics, opto-style compression, and a de-esser. Air enhancement is folded into the EQ's air band, and a transparent output limiter catches final peaks."
        }
      },
      {
        "@type": "Question",
        "name": "Does ZVocals include presets?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. ZVocals ships with four factory presets: Neutral, Warm & Full, Bright & Punchy, and Open & Intimate — professional starting points for any vocal type."
        }
      },
      {
        "@type": "Question",
        "name": "Why only three knobs?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The three macros replace 55 expert parameters. Instead of tuning six stages individually, you shape tone, punch, and body — the three things singers and engineers actually listen for. The macros are orthogonal: each changes a different part of the sound, so they never just 'add more compression.'"
        }
      },
      {
        "@type": "Question",
        "name": "Does ZVocals support mono audio?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. ZVocals accepts mono or stereo input and output, so it works on mono vocal tracks and stereo vocal buses alike."
        }
      },
      {
        "@type": "Question",
        "name": "Is ZVocals CPU-intensive?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. ZVocals runs a zero-latency, minimum-phase chain with a real-time-safe macro engine that computes all stage targets per block with no heap allocation. It is optimized for use across large sessions."
        }
      }
    ]
  })} />

  <main class="relative z-[1] bg-[#050505] min-h-screen pt-24 pb-24 px-6 md:px-10">
    <div class="max-w-[900px] mx-auto">
      <!-- Breadcrumb -->
      <nav class="mb-8 font-['Inter'] text-[13px] text-[#64748B]">
        <a href="/" class="hover:text-white transition-colors">Zarlino Audio</a>
        <span class="mx-2">/</span>
        <a href="/#plugins" class="hover:text-white transition-colors">Plugins</a>
        <span class="mx-2">/</span>
        <span class="text-[#94A3B8]">ZVocals</span>
      </nav>

      <div class="flex items-center gap-2 mb-4">
        <span class="inline-block font-['IBM_Plex_Mono'] text-[11px] uppercase tracking-[0.1em] text-[#00D4FF] border border-[rgba(0,212,255,0.3)] rounded-full px-3 py-1">
          Vocal Channel Strip
        </span>
        <span class="inline-block font-['IBM_Plex_Mono'] text-[11px] uppercase tracking-[0.1em] text-[#FBBF24] border border-[rgba(251,191,36,0.35)] rounded-full px-3 py-1">
          Preorder
        </span>
      </div>

      <!-- H1 -->
      <h1 class="font-['Space_Grotesk'] font-semibold text-white" style="font-size: clamp(40px, 5vw, 64px); line-height: 1.1; letter-spacing: -0.03em;">
        ZVocals
      </h1>

      <!-- Tagline -->
      <p class="mt-4 font-['Inter'] text-[18px] text-[#94A3B8] leading-[1.7] max-w-[650px]">
        A professional vocal chain in three knobs. TONE, PUNCH, and BODY shape a five-stage processor — SSL EQ, FET compression, 4-band multiband, opto compression, and an always-adaptive de-esser.
      </p>

      <!-- Pricing + CTA -->
      <div class="mt-8 flex items-center gap-4 flex-wrap">
        <span class="font-['Space_Grotesk'] font-semibold text-[36px] text-white">$149</span>
        <span class="font-['Space_Grotesk'] text-[18px] text-[#64748B] line-through">$199</span>
        <span class="font-['Inter'] text-[14px] text-[#94A3B8]">
          Pre-order — a 14-day fully functional trial is built in.
        </span>
        <a href="#download" class="inline-flex items-center bg-[#00D4FF] text-[#050505] rounded-lg px-8 py-[14px] font-['Inter'] font-medium text-[15px] hover:bg-[#33DDFF] transition-colors duration-300">
          Try ZVocals
        </a>
      </div>

      <!-- Product Image -->
      <div class="mt-12 rounded-xl overflow-hidden" style="box-shadow: 0 40px 80px rgba(0,0,0,0.5);">
        <img src="/images/zvocals-ui.jpg" alt="ZVocals three-macro vocal channel strip interface showing TONE, PUNCH, and BODY macro controls" class="w-full h-auto object-cover" />
      </div>

      <!-- Download -->
      <section class="mt-14" id="download">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-2">Download ZVocals 0.1.0</h2>
        <p class="font-['Inter'] text-[15px] text-[#94A3B8] leading-[1.7] mb-6 max-w-[650px]">
          Grab the installer for the full standalone app, or the VST3 for your DAW. All builds are Windows 10 22H2+ (64-bit).
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <a
            href="/downloads/ZVocals-v0.1.0-Windows-Installer.exe"
            download
            class="group flex flex-col justify-between rounded-xl border border-[rgba(0,212,255,0.25)] bg-[rgba(0,212,255,0.04)] p-6 hover:bg-[rgba(0,212,255,0.08)] transition-colors duration-300"
          >
            <div>
              <h3 class="font-['Space_Grotesk'] font-semibold text-white text-[18px]">Standalone Installer</h3>
              <p class="mt-2 font-['Inter'] text-[13px] text-[#94A3B8] leading-[1.6]">Windows installer (.exe) — includes the app and VST3 plugin.</p>
            </div>
            <span class="mt-5 inline-flex items-center gap-2 font-['Inter'] font-medium text-[14px] text-[#00D4FF] group-hover:gap-3 transition-all">
              <Download size={15} /> Download .exe &middot; 4 MB
            </span>
          </a>

          <a
            href="/downloads/ZVocals-v0.1.0-Windows-VST3.zip"
            download
            class="group flex flex-col justify-between rounded-xl border border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.03)] p-6 hover:bg-[rgba(255,255,255,0.06)] transition-colors duration-300"
          >
            <div>
              <h3 class="font-['Space_Grotesk'] font-semibold text-white text-[18px]">VST3 Plugin</h3>
              <p class="mt-2 font-['Inter'] text-[13px] text-[#94A3B8] leading-[1.6]">VST3 bundle (.zip) for FL Studio, Ableton Live, Cubase, Reaper, and more.</p>
            </div>
            <span class="mt-5 inline-flex items-center gap-2 font-['Inter'] font-medium text-[14px] text-[#00D4FF] group-hover:gap-3 transition-all">
              <Download size={15} /> Download VST3 &middot; 2 MB
            </span>
          </a>

          <a
            href="/downloads/ZVocals-v0.1.0-Windows-Standalone.zip"
            download
            class="group flex flex-col justify-between rounded-xl border border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.03)] p-6 hover:bg-[rgba(255,255,255,0.06)] transition-colors duration-300"
          >
            <div>
              <h3 class="font-['Space_Grotesk'] font-semibold text-white text-[18px]">Standalone App</h3>
              <p class="mt-2 font-['Inter'] text-[13px] text-[#94A3B8] leading-[1.6]">Portable standalone build (.zip) — no installer required.</p>
            </div>
            <span class="mt-5 inline-flex items-center gap-2 font-['Inter'] font-medium text-[14px] text-[#00D4FF] group-hover:gap-3 transition-all">
              <Download size={15} /> Download .zip &middot; 2 MB
            </span>
          </a>
        </div>
      </section>

      <!-- What It Does -->
      <section class="mt-16">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">What ZVocals Does</h2>
        <div class="font-['Inter'] text-[16px] text-[#94A3B8] leading-[1.8] space-y-4">
          <p>
            ZVocals replaces 55 expert parameters with three musical macros. Instead of stacking separate EQ, compressor, multiband, and de-esser plugins — or clicking through a wall of knobs — you shape the three things you actually listen for: tone, punch, and body.
          </p>
          <p>
            The macros stay orthogonal. TONE steers spectral balance from warm to bright across the SSL EQ and the stages that follow. PUNCH governs how much of the transient and consonant envelope projects through the sustained body. BODY controls perceived density and weight through low-end EQ, FET sustain, and opto glue. They never just 'add more compression' — each macro has a distinct mechanism and audible identity.
          </p>
          <p>
            <strong>ZVocals vs. building your own vocal chain:</strong> A complete five-stage chain — SSL EQ, FET compression, 4-band multiband dynamics, opto compression, and an always-content-adaptive de-esser — runs in a single, recallable window. You get a professional vocal sound in seconds, and your entire setup saves as one preset.
          </p>
        </div>
      </section>

      <!-- The Three Macros -->
      <section class="mt-12">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">The Three Macros</h2>
        <div class="font-['Inter'] text-[15px] text-[#94A3B8] leading-[1.8] space-y-4">
          <p><strong class="text-[#CBD5E1]">TONE — Warm to Bright.</strong> Spectral balance. The SSL EQ shifts low shelf, low-mid, presence, and air bands, and the FET, multiband, and opto stages follow with matching character. 'Make it brighter' is one knob turn.</p>
          <p><strong class="text-[#CBD5E1]">PUNCH — Soft to Impactful.</strong> Transient envelope. The FET is the punch engine — attack slows and ratio rises so 2–5 kHz articulation survives while the multiband controls the body underneath. The opto steps back so it never squashes the transient.</p>
          <p><strong class="text-[#CBD5E1]">BODY — Thin to Thick.</strong> Sustained density. Low-end EQ adds weight, the FET catches sustain with faster attack and slower release, and the opto adds smooth, dense glue.</p>
          <p><strong class="text-[#CBD5E1]">De-Esser — always adaptive.</strong> The one stage that never gets forced harder as a side effect. It stays content-adaptive across every macro position.</p>
        </div>
      </section>

      <!-- Five-Stage Chain -->
      <section class="mt-12">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">The Five-Stage Chain</h2>
        <div class="font-['Inter'] text-[15px] text-[#94A3B8] leading-[1.8] space-y-2">
          <p><strong class="text-[#CBD5E1]">1. SSL EQ</strong> — Spectral foundation. Shapes what every downstream stage 'sees' — the primary home of the TONE macro.</p>
          <p><strong class="text-[#CBD5E1]">2. FET Compression</strong> — Strength and character. The punch engine: attack, release, ratio, and transient sensitivity respond to PUNCH and BODY.</p>
          <p><strong class="text-[#CBD5E1]">3. 4-Band Multiband</strong> — Spectral control. Keeps EQ and FET character from becoming uncontrolled, band by band.</p>
          <p><strong class="text-[#CBD5E1]">4. Opto Compression</strong> — Smoothness and glue. Adds smooth sustained density; steps back as PUNCH rises.</p>
          <p><strong class="text-[#CBD5E1]">5. De-Esser</strong> — Adaptive sibilance control. Fixed, content-adaptive, and never driven harder by any macro.</p>
        </div>
      </section>

      <!-- Key Features -->
      <section class="mt-12">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">Key Features</h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Three orthogonal macros: TONE, PUNCH, BODY — no 'three knobs that all add compression'
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Five-stage chain: SSL EQ &rarr; FET comp &rarr; 4-band multiband &rarr; opto comp &rarr; de-esser
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Always-content-adaptive de-esser — never forced harder by a macro
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Punch × Body attack blend on the FET — graceful, never snapping
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Factory presets: Neutral, Warm & Full, Bright & Punchy, Open & Intimate
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Zero-latency minimum-phase processing, real-time-safe macro engine
          </li>
        </ul>
      </section>

      <!-- System Requirements -->
      <section class="mt-12">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">System Requirements</h2>
        <ul class="font-['Inter'] text-[15px] text-[#94A3B8] leading-[1.8] space-y-1 list-disc list-inside">
          <li>Windows 10 22H2 or later (64-bit)</li>
          <li>VST3-compatible 64-bit host (FL Studio, Ableton Live, Cubase, Reaper, Studio One, Bitwig) or standalone app</li>
          <li>4 GB RAM minimum</li>
          <li>44.1 kHz – 192 kHz audio interface or session</li>
          <li>Channels: Mono or stereo input and output</li>
          <li>Latency: zero — minimum-phase chain with no added latency</li>
        </ul>
      </section>

      <!-- FAQ -->
      <section class="mt-12" id="faq">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">Frequently Asked Questions</h2>
        <div class="space-y-6 font-['Inter']">
          <div>
            <h3 class="text-[16px] font-semibold text-white mb-1">What vocal styles is this designed for?</h3>
            <p class="text-[15px] text-[#94A3B8] leading-[1.7]">ZVocals is genre-agnostic. It works on lead and backing vocals, spoken word, voiceover, and sung parts across pop, rock, hip-hop, EDM, and cinematic contexts.</p>
          </div>
          <div>
            <h3 class="text-[16px] font-semibold text-white mb-1">How does this compare to using separate plugins?</h3>
            <p class="text-[15px] text-[#94A3B8] leading-[1.7]">ZVocals eliminates the need to manage gain staging across five separate processors and removes 55 expert parameters. Three macros shape the entire chain, and your whole vocal sound saves as a single, recallable preset.</p>
          </div>
          <div>
            <h3 class="text-[16px] font-semibold text-white mb-1">Are there any hidden expert controls?</h3>
            <p class="text-[15px] text-[#94A3B8] leading-[1.7]">No. ZVocals exposes exactly three macro knobs plus input trim, output trim, and a limiter ceiling. Everything else is derived internally from the macros.</p>
          </div>
          <div>
            <h3 class="text-[16px] font-semibold text-white mb-1">Does ZVocals support mono tracks?</h3>
            <p class="text-[15px] text-[#94A3B8] leading-[1.7]">Yes. ZVocals accepts mono or stereo input and output, so it works on mono vocal tracks and stereo vocal buses alike.</p>
          </div>
          <div>
            <h3 class="text-[16px] font-semibold text-white mb-1">Is there a free trial?</h3>
            <p class="text-[15px] text-[#94A3B8] leading-[1.7]">Yes. ZVocals includes a 14-day fully functional trial. A license key is required for continued use after the trial period.</p>
          </div>
        </div>
      </section>

      <!-- Changelog -->
      <section class="mt-12">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">Changelog</h2>
        <div class="font-['Inter'] text-[15px] text-[#94A3B8] leading-[1.8]">
          <h3 class="text-[16px] font-semibold text-white mb-2">0.1.0 — Three-Macro Rebrand</h3>
          <ul class="list-disc list-inside space-y-1">
            <li>Rebranded from VocalToneShaper to ZVocals</li>
            <li>Three-macro control system replaces 55 expert parameters</li>
            <li>Five-stage chain: SSL EQ, FET, 4-band multiband, opto, de-esser</li>
            <li>Always-content-adaptive de-esser</li>
            <li>Four factory presets</li>
          </ul>
        </div>
      </section>

      <!-- More from the Zarlino ecosystem -->
      <section class="mt-16 pt-8 border-t border-[rgba(255,255,255,0.06)]">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[24px] text-white mb-6">More from the Zarlino Audio lineup</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <a href="/plugins/ztame" class="group rounded-xl border border-[rgba(255,255,255,0.08)] bg-[rgba(255,255,255,0.03)] p-6 hover:border-[rgba(0,212,255,0.35)] hover:bg-[rgba(0,212,255,0.05)] transition-colors duration-300">
            <div class="flex items-center justify-between">
              <h3 class="font-['Space_Grotesk'] font-semibold text-white text-[18px]">ZTame</h3>
              <span class="font-['IBM_Plex_Mono'] text-[10px] uppercase tracking-[0.1em] text-[#00D4FF] border border-[rgba(0,212,255,0.3)] rounded-full px-2 py-0.5">Resonance Suppressor</span>
            </div>
            <p class="mt-2 font-['Inter'] text-[13px] text-[#94A3B8] leading-[1.6]">High-resolution FFT-based dynamic resonance suppression for harsh frequencies and ringing — the Soothe 3 alternative for spectral dynamics.</p>
            <span class="mt-4 inline-block font-['Inter'] font-medium text-[14px] text-[#00D4FF] group-hover:underline">Learn more →</span>
          </a>
          <a href="/plugins/zscorch" class="group rounded-xl border border-[rgba(255,255,255,0.08)] bg-[rgba(255,255,255,0.03)] p-6 hover:border-[rgba(0,212,255,0.35)] hover:bg-[rgba(0,212,255,0.05)] transition-colors duration-300">
            <div class="flex items-center justify-between">
              <h3 class="font-['Space_Grotesk'] font-semibold text-white text-[18px]">ZScorch</h3>
              <span class="font-['IBM_Plex_Mono'] text-[10px] uppercase tracking-[0.1em] text-[#00D4FF] border border-[rgba(0,212,255,0.3)] rounded-full px-2 py-0.5">Harmonic Processor</span>
            </div>
            <p class="mt-2 font-['Inter'] text-[13px] text-[#94A3B8] leading-[1.6]">Adaptive harmonic processing with six saturation topologies — Tube, Tape, Germanium, Transistor, Diode, and Wavefold — driven by Lift, Character, and Mix macros.</p>
            <span class="mt-4 inline-block font-['Inter'] font-medium text-[14px] text-[#00D4FF] group-hover:underline">Learn more →</span>
          </a>
        </div>
      </section>

      <!-- Back to Plugins -->
      <div class="mt-16 pt-8 border-t border-[rgba(255,255,255,0.06)]">
        <a href="/#plugins" class="font-['Inter'] text-[15px] text-[#00D4FF] hover:underline">
          &larr; Back to All Plugins
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
