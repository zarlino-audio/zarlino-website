---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AddToCartButton from '../../components/AddToCartButton';
import { Download } from 'lucide-react';
---

<BaseLayout
  title="ZTame — Dynamic Resonance Suppressor by Zarlino Audio"
  description="ZTame is Zarlino Audio's zero-latency automatic resonance suppressor. Per-band dynamic reduction with FFT-based peak detection, selectivity gating, a draggable focus band, Delta audition, and Mid/Side processing for mixing and mastering engineers. Windows VST3."
  canonicalURL="https://zarlinoaudio.com/plugins/ztame"
  schemaType="product"
>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "ZTame",
    "applicationCategory": "MusicApplication",
    "operatingSystem": "Windows 10 22H2 or later",
    "description": "Zero-latency automatic resonance suppressor: per-band dynamic reduction with FFT-based peak detection, selectivity gating, draggable focus band, Delta audition, and Mid/Side processing.",
    "offers": {
      "@type": "Offer",
      "price": "49.00",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
      "description": "14-day fully functional trial, then a one-time $49 perpetual license. Windows VST3.",
      "url": "https://zarlinoaudio.com/plugins/ztame"
    },
    "author": {
      "@type": "Organization",
      "name": "Zarlino Audio"
    },
    "version": "1.2.0",
    "sku": "ZA-ZTAME-120"
  })} />

  <!-- BreadcrumbList Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://zarlinoaudio.com/" },
      { "@type": "ListItem", "position": 2, "name": "Plugins", "item": "https://zarlinoaudio.com/#plugins" },
      { "@type": "ListItem", "position": 3, "name": "ZTame", "item": "https://zarlinoaudio.com/plugins/ztame" }
    ]
  })} />

  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Does ZTame support AU or AAX formats?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. ZTame version 1.2.0 is Windows VST3 only. AU and AAX support may be considered for future releases."
        }
      },
      {
        "@type": "Question",
        "name": "Can ZTame process mono audio?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The main processing path is mono or stereo; Mid/Side modes require a stereo bus. ZTame version 1.2.0 handles mono main input directly, and stereo material can be processed in Stereo, M/S Blend, Mid Only, or Side Only modes."
        }
      },
      {
        "@type": "Question",
        "name": "Does ZTame accept MIDI input?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. ZTame is an audio-only processor with no MIDI input, MIDI output, or MIDI learn feature."
        }
      },
      {
        "@type": "Question",
        "name": "How does ZTame compare to Soothe 3?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "ZTame is a Soothe 3 alternative in the same category of dynamic resonance suppressors. Like its peers, ZTame detects narrow, persistent spectral peaks and applies dynamic reduction. ZTame differentiates with zero latency (no PDC shift, safe on any bus), a draggable focus band, Delta audition of exactly what is removed, bit-transparent idle processing, and Mid/Side processing modes at $49."
        }
      },
      {
        "@type": "Question",
        "name": "What are the system requirements for ZTame?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "ZTame requires a 64-bit VST3-capable host running on Windows 10 22H2 or later, with 4 GB RAM and a 44.1–192 kHz audio interface or session."
        }
      },
      {
        "@type": "Question",
        "name": "Is there a free trial for ZTame?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. ZTame includes a 14-day fully functional trial. After the trial, a one-time purchase of $49 buys a perpetual license — no subscription."
        }
      }
    ]
  })} />

  <main class="relative z-[1] bg-[#050505] min-h-screen pt-24 pb-24 px-6 md:px-10">
    <div class="max-w-[900px] mx-auto">
      <!-- Breadcrumb -->
      <nav class="mb-8 font-['Inter'] text-[13px] text-[#64748B]">
        <a href="/" class="hover:text-white transition-colors">Zarlino Audio</a>
        <span class="mx-2">/</span>
        <a href="/#plugins" class="hover:text-white transition-colors">Plugins</a>
        <span class="mx-2">/</span>
        <span class="text-[#94A3B8]">ZTame</span>
      </nav>

      <div class="flex items-center gap-2 mb-4">
        <span class="inline-block font-['IBM_Plex_Mono'] text-[11px] uppercase tracking-[0.1em] text-[#00D4FF] border border-[rgba(0,212,255,0.3)] rounded-full px-3 py-1">
          Resonance Suppressor
        </span>
        <span class="inline-block font-['IBM_Plex_Mono'] text-[11px] uppercase tracking-[0.1em] text-[#FBBF24] border border-[rgba(251,191,36,0.35)] rounded-full px-3 py-1">
          Public Beta
        </span>
      </div>

      <!-- H1 -->
      <h1 class="font-['Space_Grotesk'] font-semibold text-white" style="font-size: clamp(40px, 5vw, 64px); line-height: 1.1; letter-spacing: -0.03em;">
        ZTame
      </h1>

      <!-- Tagline -->
      <p class="mt-4 font-['Inter'] text-[18px] text-[#94A3B8] leading-[1.7] max-w-[650px]">
        A zero-latency automatic resonance suppressor: it finds narrow, persistent spectral peaks and pulls them down with per-band dynamic reduction — leaving the tonal mass around them intact.
      </p>

      <!-- BETA notice -->
      <p class="mt-4 font-['Inter'] text-[14px] text-[#94A3B8] leading-[1.7] max-w-[650px] border border-[rgba(251,191,36,0.2)] bg-[rgba(251,191,36,0.05)] rounded-lg px-4 py-3">
        <strong class="text-[#FBBF24]">Public beta — on sale now.</strong> Try ZTame 1.2.0 free for
        14 days; buy once and keep it forever. Found an issue?{' '}
        <a href="/report" class="text-[#00D4FF] hover:underline">Report it here</a>.
      </p>

      <!-- Pricing + CTA -->
      <div class="mt-8 flex items-center gap-4 flex-wrap" id="buy">
        <span class="font-['Space_Grotesk'] font-semibold text-[36px] text-white">$49</span>
        <span class="font-['Inter'] text-[14px] text-[#94A3B8]">
          one-time purchase &middot; perpetual license &middot; 14-day free trial
        </span>
        <AddToCartButton item={{ id: 'ztame', name: 'ZTame', price: 750, image: '/images/ztame-ui-1.2.png', category: 'Resonance Suppressor' }} label="Buy ZTame — $49" client:load />
        <a href="#download" class="font-['Inter'] text-[14px] text-[#00D4FF] hover:underline">or download the trial first</a>
      </div>

      <!-- Product Image -->
      <div class="mt-12 rounded-xl overflow-hidden" style="box-shadow: 0 40px 80px rgba(0,0,0,0.5);">
        <img src="/images/ztame-ui-1.2.png" alt="ZTame resonance suppressor plugin user interface with spectrum display, draggable focus band and control panels" class="w-full h-auto object-cover" />
      </div>

      <!-- Download -->
      <section class="mt-14" id="download">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-2">Download ZTame 1.2.0</h2>
        <p class="font-['Inter'] text-[15px] text-[#94A3B8] leading-[1.7] mb-6 max-w-[650px]">
          Grab the installer for the full standalone app, or the VST3 for your DAW. This is a public beta build of
          ZTame 1.2.0. All builds are Windows 10 22H2+ (64-bit).
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <a
            href="/downloads/ZTame-v1.2.0-Windows-Installer.exe"
            download
            class="group flex flex-col justify-between rounded-xl border border-[rgba(0,212,255,0.25)] bg-[rgba(0,212,255,0.04)] p-6 hover:bg-[rgba(0,212,255,0.08)] transition-colors duration-300"
          >
            <div>
              <h3 class="font-['Space_Grotesk'] font-semibold text-white text-[18px]">Standalone Installer</h3>
              <p class="mt-2 font-['Inter'] text-[13px] text-[#94A3B8] leading-[1.6]">Windows installer (.exe) — includes the app and VST3 plugin.</p>
            </div>
            <span class="mt-5 inline-flex items-center gap-2 font-['Inter'] font-medium text-[14px] text-[#00D4FF] group-hover:gap-3 transition-all">
              <Download size={15} /> Download .exe &middot; 4 MB
            </span>
          </a>

          <a
            href="/downloads/ZTame-v1.2.0-Windows-VST3.zip"
            download
            class="group flex flex-col justify-between rounded-xl border border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.03)] p-6 hover:bg-[rgba(255,255,255,0.06)] transition-colors duration-300"
          >
            <div>
              <h3 class="font-['Space_Grotesk'] font-semibold text-white text-[18px]">VST3 Plugin</h3>
              <p class="mt-2 font-['Inter'] text-[13px] text-[#94A3B8] leading-[1.6]">VST3 bundle (.zip) for FL Studio, Ableton Live, Cubase, Reaper, and more.</p>
            </div>
            <span class="mt-5 inline-flex items-center gap-2 font-['Inter'] font-medium text-[14px] text-[#00D4FF] group-hover:gap-3 transition-all">
              <Download size={15} /> Download VST3 &middot; 2 MB
            </span>
          </a>

          <a
            href="/downloads/ZTame-v1.2.0-Windows-Standalone.zip"
            download
            class="group flex flex-col justify-between rounded-xl border border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.03)] p-6 hover:bg-[rgba(255,255,255,0.06)] transition-colors duration-300"
          >
            <div>
              <h3 class="font-['Space_Grotesk'] font-semibold text-white text-[18px]">Standalone App</h3>
              <p class="mt-2 font-['Inter'] text-[13px] text-[#94A3B8] leading-[1.6]">Portable standalone build (.zip) — no installer required.</p>
            </div>
            <span class="mt-5 inline-flex items-center gap-2 font-['Inter'] font-medium text-[14px] text-[#00D4FF] group-hover:gap-3 transition-all">
              <Download size={15} /> Download .zip &middot; 2 MB
            </span>
          </a>
        </div>
      </section>

      <!-- License -->
      <section class="mt-14" id="license">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-2">Activate ZTame</h2>
        <p class="font-['Inter'] text-[15px] text-[#94A3B8] leading-[1.7] mb-6 max-w-[650px]">
          ZTame runs fully functional for 14 days. After that, paste your license key into the plugin's
          activation screen. Your key is shown on the checkout page right after payment — save it somewhere
          safe. Lost your key?{' '}
          <a href="mailto:support@zarlinoaudio.com" class="text-[#00D4FF] hover:underline">Email support</a>{' '}
          and we'll re-issue it. See the{' '}
          <a href="/legal/refunds" class="text-[#00D4FF] hover:underline">refund policy</a>{' '}
          for the 14-day money-back window.
        </p>
      </section>

      <!-- What It Does -->
      <section class="mt-16">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">What ZTame Does</h2>
        <div class="font-['Inter'] text-[16px] text-[#94A3B8] leading-[1.8] space-y-4">
          <p>
            ZTame detects narrow, persistent spectral peaks in your audio and pulls them down with per-band dynamic reduction — but only while they are present. The engine is causal end-to-end: nothing is delayed, nothing is pre-computed from future samples, and material that is not being reduced passes through sample-exactly.
          </p>
          <p>
            Insert ZTame on vocals to tame harsh sibilance without over-compressing. Place it on a drum bus to knock down ringing cymbal frequencies. Use it on a master bus to clean up room resonances before they reach your limiter. The per-peak detection engine works continuously, adapting to the material as it plays.
          </p>
          <p>
            <strong>ZTame vs. dynamic resonance suppressors like Soothe 3:</strong> ZTame competes in the same category of spectral dynamics processors that have become essential tools in modern mixing. It distinguishes itself with zero latency (no PDC shift — safe on any bus), a draggable focus band, Delta audition of exactly what is removed, bit-transparent idle processing, and built-in Mid/Side modes — all without requiring a separate subscription or iLok dongle.
          </p>
        </div>
      </section>

      <!-- Key Features -->
      <section class="mt-12">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">Key Features</h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Zero-latency engine — no delay, no PDC shift, safe on any bus
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Bit-transparent when idle: untouched material passes through sample-exactly
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Selectivity gating for precise control over peak definition
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Draggable focus band — restrict suppression to exactly the region you choose
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Stereo and Mid/Side processing modes
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            32 or 48 correction bands (Standard / Precise)
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Delta (Listen) audition — hear exactly what is being removed
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Dry/Wet, Bypass, Stereo Link, and an optional sidechain detection bus
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Real-time spectrum display and gain reduction metering
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Seven factory programs: Init, Vocal Soothe, Room Tamer, Drum Ring, Master Polish, De-Harsh, Extreme Ring
          </li>
        </ul>
      </section>

      <!-- Controls Overview -->
      <section class="mt-12">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">Controls</h2>
        <div class="font-['Inter'] text-[15px] text-[#94A3B8] leading-[1.8] space-y-2">
          <p><strong class="text-[#CBD5E1]">Sensitivity</strong> — Threshold for spectral peak detection. Raise until the gain reduction meter moves on harsh resonances.</p>
          <p><strong class="text-[#CBD5E1]">Range</strong> — Maximum dynamic reduction applied to detected peaks (in dB).</p>
          <p><strong class="text-[#CBD5E1]">Selectivity</strong> — How narrowly a spectral peak must be defined before reduction engages. Higher values require sharper, more isolated peaks.</p>
          <p><strong class="text-[#CBD5E1]">Focus Low / High</strong> — Restrict suppression to a frequency region with soft skirts. Drag the band directly in the spectrum display.</p>
          <p><strong class="text-[#CBD5E1]">Attack / Release</strong> — How quickly reduction engages and recovers after a peak subsides.</p>
          <p><strong class="text-[#CBD5E1]">Delta (Listen)</strong> — Outputs only the removed material (+6 dB monitor) for precise auditioning.</p>
          <p><strong class="text-[#CBD5E1]">Mix</strong> — Parallel blend of dry and processed signals. Both paths are sample-aligned, so the mix cannot comb.</p>
          <p><strong class="text-[#CBD5E1]">Bands</strong> — Standard (32 bands, lowest CPU) or Precise (48 bands, finer centres). Both run at zero latency.</p>
          <p><strong class="text-[#CBD5E1]">Mode</strong> — Stereo, M/S Blend, Mid Only, or Side Only. Mid/Side modes encode L/R into Mid/Side, process, then decode back to L/R; isolation modes process only the Mid or only the Side channel.</p>
        </div>
      </section>

      <!-- System Requirements -->
      <section class="mt-12">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">System Requirements</h2>
        <ul class="font-['Inter'] text-[15px] text-[#94A3B8] leading-[1.8] space-y-1 list-disc list-inside">
          <li>Windows 10 22H2 or later (64-bit)</li>
          <li>VST3-compatible 64-bit host (FL Studio, Ableton Live, Cubase, Reaper, Studio One, Bitwig)</li>
          <li>4 GB RAM minimum</li>
          <li>44.1 kHz – 192 kHz audio interface or session</li>
          <li>Format: VST3 only (AU and AAX not available in v1.2.0)</li>
          <li>Channels: mono or stereo main path (Mid/Side modes require stereo)</li>
          <li>Latency: 0 samples — the engine is causal end-to-end, so there is no PDC offset and no comb filtering on parallel buses.</li>
        </ul>
      </section>

      <!-- FAQ -->
      <section class="mt-12">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">Frequently Asked Questions</h2>
        <div class="space-y-6 font-['Inter']">
          <div>
            <h3 class="text-[16px] font-semibold text-white mb-1">Does ZTame support AU or AAX formats?</h3>
            <p class="text-[15px] text-[#94A3B8] leading-[1.7]">No. ZTame version 1.2.0 is Windows VST3 only. AU (macOS) and AAX (Pro Tools) support may be considered for future releases based on customer demand.</p>
          </div>
          <div>
            <h3 class="text-[16px] font-semibold text-white mb-1">How does ZTame compare to Soothe 3?</h3>
            <p class="text-[15px] text-[#94A3B8] leading-[1.7]">ZTame is a dynamic resonance suppressor in the same category as Soothe 3, DSEQ3, and similar spectral dynamics processors. ZTame offers zero latency (no PDC shift), a draggable focus band, Delta audition, bit-transparent idle processing, and Mid/Side modes at a competitive $49 price point with no subscription required. The right choice depends on your workflow — we recommend trying both to see which detection behavior fits your material.</p>
          </div>
          <div>
            <h3 class="text-[16px] font-semibold text-white mb-1">Can I use ZTame on mono tracks?</h3>
            <p class="text-[15px] text-[#94A3B8] leading-[1.7]">The main path is mono or stereo; Mid/Side modes require a stereo bus. ZTame version 1.2.0 handles mono main input directly, and stereo material can be processed as Stereo, M/S Blend, Mid Only, or Side Only.</p>
          </div>
          <div>
            <h3 class="text-[16px] font-semibold text-white mb-1">Is there a free trial?</h3>
            <p class="text-[15px] text-[#94A3B8] leading-[1.7]">Yes. ZTame includes a 14-day fully functional trial. After that, a one-time purchase of <strong class="text-[#CBD5E1]">$49</strong> buys a perpetual license — yours forever, no subscription.</p>
          </div>
          <div>
            <h3 class="text-[16px] font-semibold text-white mb-1">What if ZTame uses too much CPU?</h3>
            <p class="text-[15px] text-[#94A3B8] leading-[1.7]">The engine is deliberately cheap when it has nothing to do: silence and "no resonance detected" blocks skip the correction path entirely, and bypass parks it. Try Standard (32 bands) instead of Precise (48), and increase your audio buffer size if your host runs very small buffers.</p>
          </div>
        </div>
      </section>

      <!-- Changelog -->
      <section class="mt-12">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">Changelog</h2>
        <div class="font-['Inter'] text-[15px] text-[#94A3B8] leading-[1.8]">
          <h3 class="text-[16px] font-semibold text-white mb-2">1.2.0 — Zero-Latency Engine</h3>
          <ul class="list-disc list-inside space-y-1">
            <li>0-sample latency on every path — no PDC offset, host bypass is a plain passthrough</li>
            <li>Bit-exact passthrough when idle (depth 0 / nothing detected)</li>
            <li>New correction engine: per-band dynamic bells replacing the STFT resynthesis path</li>
            <li>Up to ~40% lower CPU on active material, ~3x lower when idle, ~18x lower on silence</li>
            <li>Seven factory programs, sidechain detection bus, Delta audition, Mid/Side modes</li>
          </ul>
          <h3 class="text-[16px] font-semibold text-white mb-2 mt-5">1.1.0 — Engine Rewrite</h3>
          <ul class="list-disc list-inside space-y-1">
            <li>Fixed STFT reconstruction (window/normalisation/bin-index defects)</li>
            <li>Declared latency, sidechain bus, draggable focus band, live removed-energy display</li>
            <li>35-suite automated test battery</li>
          </ul>
          <h3 class="text-[16px] font-semibold text-white mb-2 mt-5">1.0.0 — Initial Release</h3>
          <ul class="list-disc list-inside space-y-1">
            <li>Dynamic spectral resonance suppression with FFT-based peak detection</li>
            <li>Stereo and Mid/Side processing modes (Stereo, M/S Blend, Mid Only, Side Only)</li>
            <li>Listen mode and real-time spectrum display with gain reduction metering</li>
          </ul>
        </div>
      </section>

      <!-- More from the Zarlino ecosystem -->
      <section class="mt-16 pt-8 border-t border-[rgba(255,255,255,0.06)]">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[24px] text-white mb-6">More from the Zarlino Audio lineup</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <a href="/plugins/zscorch" class="group rounded-xl border border-[rgba(255,255,255,0.08)] bg-[rgba(255,255,255,0.03)] p-6 hover:border-[rgba(0,212,255,0.35)] hover:bg-[rgba(0,212,255,0.05)] transition-colors duration-300">
            <div class="flex items-center justify-between">
              <h3 class="font-['Space_Grotesk'] font-semibold text-white text-[18px]">ZScorch</h3>
              <span class="font-['IBM_Plex_Mono'] text-[10px] uppercase tracking-[0.1em] text-[#00D4FF] border border-[rgba(0,212,255,0.3)] rounded-full px-2 py-0.5">Adaptive Harmonic Processor</span>
            </div>
            <p class="mt-2 font-['Inter'] text-[13px] text-[#94A3B8] leading-[1.6]">Multi-mode multiband harmonic saturation with Lift, Character, and Mix macros. Warm up, distort, and glue with six saturation topologies.</p>
            <span class="mt-4 inline-block font-['Inter'] font-medium text-[14px] text-[#00D4FF] group-hover:underline">Learn more →</span>
          </a>
        </div>
      </section>

      <!-- Back to Plugins -->
      <div class="mt-16 pt-8 border-t border-[rgba(255,255,255,0.06)]">
        <a href="/#plugins" class="font-['Inter'] text-[15px] text-[#00D4FF] hover:underline">
          &larr; Back to All Plugins
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
