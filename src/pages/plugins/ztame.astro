---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Download } from 'lucide-react';
import AddToCartButton from '../../components/AddToCartButton';
import ABPlayer from '../../components/ABPlayer';
import CompatibilitySection from '../../components/CompatibilitySection';
import TestimonialSection from '../../components/TestimonialSection';
import EmailCapture from '../../components/EmailCapture';
import CrossSellSection from '../../components/CrossSellSection';
import { PRODUCTS } from '../../config/products';
const ztame = PRODUCTS.ztame;
---

<BaseLayout
  title="ZTame — Dynamic Resonance Suppressor by Zarlino Audio"
  description="ZTame is Zarlino Audio's high-resolution FFT-based automatic resonance suppressor. Per-peak dynamic notch filtering, selectivity gating, split-band operation, and solo monitoring for mixing and mastering engineers. Windows VST3."
  canonicalURL="https://zarlinoaudio.com/plugins/ztame"
  schemaType="product"
>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "ZTame",
    "applicationCategory": "MusicApplication",
    "operatingSystem": "Windows 10 22H2 or later",
    "description": "High-resolution FFT-based automatic resonance suppressor with per-peak dynamic notch filtering, selectivity gating, split-band operation, and solo monitoring.",
    "offers": {
      "@type": "Offer",
      "price": "49.00",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
      "description": "One-time purchase. $49 (₵750) for a perpetual license. A 14-day fully functional trial is built into the plugin.",
      "url": "https://zarlinoaudio.com/plugins/ztame"
    },
    "author": {
      "@type": "Organization",
      "name": "Zarlino Audio"
    },
    "version": "1.0.0",
    "sku": "ZA-ZTAME-100"
  })} />

  <!-- BreadcrumbList Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://zarlinoaudio.com/" },
      { "@type": "ListItem", "position": 2, "name": "Plugins", "item": "https://zarlinoaudio.com/#plugins" },
      { "@type": "ListItem", "position": 3, "name": "ZTame", "item": "https://zarlinoaudio.com/plugins/ztame" }
    ]
  })} />

  <!-- FAQPage Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Does ZTame support AU or AAX formats?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. ZTame version 1.0.0 is Windows VST3 only. AU and AAX support may be considered for future releases."
        }
      },
      {
        "@type": "Question",
        "name": "Can ZTame process mono audio?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. ZTame version 1.0.0 is a stereo-only processor. Its FFT engine, spectral detection, and Mid/Side modes require a stereo (2-channel) bus. Use it on stereo tracks and buses; insert a stereo-capable upmixer or process at the stereo bus level for mono sources."
        }
      },
      {
        "@type": "Question",
        "name": "Does ZTame accept MIDI input?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. ZTame is an audio-only processor with no MIDI input, MIDI output, or MIDI learn feature."
        }
      },
      {
        "@type": "Question",
        "name": "How does ZTame compare to Soothe 3?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "ZTame is a Soothe 3 alternative in the same category of dynamic resonance suppressors and spectral dynamics processors. Like its peers, ZTame detects narrow, persistent spectral peaks and applies dynamic reduction. ZTame differentiates with selectivity gating, split-band crossover detection, latency-aligned Dry/Wet control, and Mid/Side processing mode at a competitive price point of $49."
        }
      },
      {
        "@type": "Question",
        "name": "What are the system requirements for ZTame?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "ZTame requires a 64-bit VST3-capable host running on Windows 10 22H2 or later, with 4 GB RAM and a 44.1–192 kHz audio interface or session."
        }
      },
      {
        "@type": "Question",
        "name": "Is there a free trial for ZTame?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. ZTame includes a 14-day fully functional trial. After the trial, a perpetual license costs $49 (₵750) — a one-time purchase with no subscriptions, dongles, or iLok."
        }
      }
    ]
  })} />

  <main class="relative z-[1] bg-[#050505] min-h-screen pt-24 pb-24 px-6 md:px-10">
    <div class="max-w-[900px] mx-auto">
      <!-- Breadcrumb -->
      <nav class="mb-8 font-['Inter'] text-[13px] text-[#64748B]">
        <a href="/" class="hover:text-white transition-colors">Zarlino Audio</a>
        <span class="mx-2">/</span>
        <a href="/#plugins" class="hover:text-white transition-colors">Plugins</a>
        <span class="mx-2">/</span>
        <span class="text-[#94A3B8]">ZTame</span>
      </nav>

      <div class="flex items-center gap-2 mb-4">
        <span class="inline-block font-['IBM_Plex_Mono'] text-[11px] uppercase tracking-[0.1em] text-[#00D4FF] border border-[rgba(0,212,255,0.3)] rounded-full px-3 py-1">
          Resonance Suppressor
        </span>
        <span class="inline-block font-['IBM_Plex_Mono'] text-[11px] uppercase tracking-[0.1em] text-[#00D4FF] border border-[rgba(0,212,255,0.35)] rounded-full px-3 py-1">
          v1.0
        </span>
      </div>

      <!-- H1 -->
      <h1 class="font-['Space_Grotesk'] font-semibold text-white" style="font-size: clamp(40px, 5vw, 64px); line-height: 1.1; letter-spacing: -0.03em;">
        ZTame
      </h1>

      <!-- Tagline (outcome-led) -->
      <p class="mt-4 font-['Inter'] text-[18px] text-[#94A3B8] leading-[1.7] max-w-[650px]">
        {ztame.tagline}
      </p>

      <!-- Problem / Outcome -->
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="rounded-xl border border-[rgba(255,255,255,0.08)] bg-[rgba(255,255,255,0.03)] p-6">
          <p class="font-['IBM_Plex_Mono'] text-[11px] uppercase tracking-[0.1em] text-[#64748B]">The problem</p>
          <p class="mt-2 font-['Inter'] text-[15px] text-[#CBD5E1] leading-[1.7]">{ztame.problem}</p>
        </div>
        <div class="rounded-xl border border-[rgba(0,212,255,0.18)] bg-[rgba(0,212,255,0.04)] p-6">
          <p class="font-['IBM_Plex_Mono'] text-[11px] uppercase tracking-[0.1em] text-[#00D4FF]">The outcome</p>
          <p class="mt-2 font-['Inter'] text-[15px] text-[#CBD5E1] leading-[1.7]">{ztame.outcome}</p>
        </div>
      </div>

      <!-- Release note -->
      <p class="mt-6 font-['Inter'] text-[14px] text-[#94A3B8] leading-[1.7] max-w-[650px] border border-[rgba(0,212,255,0.2)] bg-[rgba(0,212,255,0.05)] rounded-lg px-4 py-3">
        <strong class="text-[#00D4FF]">v1.0 now available.</strong> Buy once, keep forever — Windows VST3, no subscriptions. Found an issue?{' '}
        <a href="/report" class="text-[#00D4FF] hover:underline">Report it here</a>.
      </p>

      <!-- Pricing + CTA -->
      <div class="mt-8 flex items-center gap-4 flex-wrap">
        <span class="font-['Space_Grotesk'] font-semibold text-[36px] text-white">{ztame.usdLabel}</span>
        <span class="font-['Inter'] text-[14px] text-[#94A3B8]">
          {ztame.priceLabelGhs} · {ztame.platform} {ztame.format} · one-time purchase
        </span>
        <AddToCartButton
          client:load
          event="buy"
          label={`Buy ${ztame.name}`}
          item={{ id: ztame.id, name: ztame.name, price: ztame.priceGhs, image: ztame.image, category: ztame.category }}
        />
      </div>

      <!-- Product Image -->
      <div class="mt-12 rounded-xl overflow-hidden" style="box-shadow: 0 40px 80px rgba(0,0,0,0.5);">
        <img src="/images/ztame-ui.png" alt="ZTame resonance suppressor plugin user interface showing spectral analysis and dynamic notch filtering controls" width="1440" height="900" class="w-full h-auto object-cover" loading="lazy" />
      </div>

      <!-- Hear it: A/B with disclosed presets -->
      <section class="mt-14">
        <ABPlayer
          client:load
          plugin="ZTame"
          demos={[
            {
              preset: 'Vocal Soothe',
              disclosure: 'FFT 2048 @50% overlap, peak-vs-floor detection, threshold ≈ 5.1 dB, max reduction 12 dB, Dry/Wet 90%.',
              a: '/audio/ZTame/A_vocal-soothe_dry.mp3',
              b: '/audio/ZTame/B_vocal-soothe_ztame.mp3',
            },
            {
              preset: 'Room Tamer',
              disclosure: 'FFT 2048, threshold ≈ 7.6 dB, max reduction 9 dB, full wet — tames ringing resonances.',
              a: '/audio/ZTame/A_room-tamer_dry.mp3',
              b: '/audio/ZTame/B_room-tamer_ztame.mp3',
            },
          ]}
        />
      </section>

      <!-- Download -->
      <section class="mt-14" id="download">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-2">Download ZTame 1.0.0</h2>
        <p class="font-['Inter'] text-[15px] text-[#94A3B8] leading-[1.7] mb-6 max-w-[650px]">
          Grab the installer for the full standalone app, or the VST3 for your DAW. This is
          ZTame 1.0.0. All builds are Windows 10 22H2+ (64-bit).
        </p>
        <div class="mb-6 flex items-start gap-3 rounded-lg border border-[rgba(251,191,36,0.45)] bg-[rgba(251,191,36,0.08)] px-4 py-3 font-['Inter'] text-[14px] text-[#FDE68A] leading-[1.7]">
          <span class="text-[#FBBF24] leading-none">&#9888;</span>
          <span>
            <strong class="text-[#FBBF24]">Disclosed pre-release - not code-signed.</strong>{' '}
            This ZTame 1.0.0 build has not yet been code-signed, so Windows SmartScreen will show an{' '}
            <strong class="text-[#FBBF24]">"Unknown publisher"</strong> warning. To install, click{' '}
            <strong class="text-[#FBBF24]">"More info"</strong> then{' '}
            <strong class="text-[#FBBF24]">"Run anyway"</strong>.
          </span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <a
            href="/downloads/ZTame-v1.0.0-Windows-Installer.exe"
            download
            data-event="download"
            class="group flex flex-col justify-between rounded-xl border border-[rgba(0,212,255,0.25)] bg-[rgba(0,212,255,0.04)] p-6 hover:bg-[rgba(0,212,255,0.08)] transition-colors duration-300"
          >
            <div>
              <h3 class="font-['Space_Grotesk'] font-semibold text-white text-[18px]">Standalone Installer</h3>
              <p class="mt-2 font-['Inter'] text-[13px] text-[#94A3B8] leading-[1.6]">Windows installer (.exe) — includes the app and VST3 plugin.</p>
            </div>
            <span class="mt-5 inline-flex items-center gap-2 font-['Inter'] font-medium text-[14px] text-[#00D4FF] group-hover:gap-3 transition-all">
              <Download size={15} /> Download .exe &middot; 4 MB
            </span>
          </a>

          <a
            href="/downloads/ZTame-v1.0.0-Windows-VST3.zip"
            download
            data-event="download"
            class="group flex flex-col justify-between rounded-xl border border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.03)] p-6 hover:bg-[rgba(255,255,255,0.06)] transition-colors duration-300"
          >
            <div>
              <h3 class="font-['Space_Grotesk'] font-semibold text-white text-[18px]">VST3 Plugin</h3>
              <p class="mt-2 font-['Inter'] text-[13px] text-[#94A3B8] leading-[1.6]">VST3 bundle (.zip) for FL Studio, Ableton Live, Cubase, Reaper, and more.</p>
            </div>
            <span class="mt-5 inline-flex items-center gap-2 font-['Inter'] font-medium text-[14px] text-[#00D4FF] group-hover:gap-3 transition-all">
              <Download size={15} /> Download VST3 &middot; 2 MB
            </span>
          </a>

          <a
            href="/downloads/ZTame-v1.0.0-Windows-Standalone.zip"
            download
            data-event="download"
            class="group flex flex-col justify-between rounded-xl border border-[rgba(255,255,255,0.1)] bg-[rgba(255,255,255,0.03)] p-6 hover:bg-[rgba(255,255,255,0.06)] transition-colors duration-300"
          >
            <div>
              <h3 class="font-['Space_Grotesk'] font-semibold text-white text-[18px]">Standalone App</h3>
              <p class="mt-2 font-['Inter'] text-[13px] text-[#94A3B8] leading-[1.6]">Portable standalone build (.zip) — no installer required.</p>
            </div>
            <span class="mt-5 inline-flex items-center gap-2 font-['Inter'] font-medium text-[14px] text-[#00D4FF] group-hover:gap-3 transition-all">
              <Download size={15} /> Download .zip &middot; 2 MB
            </span>
          </a>
        </div>
      </section>

      <!-- Buy -->
      <section class="mt-14" id="buy">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-2">Get ZTame</h2>
        <p class="font-['Inter'] text-[15px] text-[#94A3B8] leading-[1.7] mb-6 max-w-[650px]">
          ZTame runs fully functional for 14 days as a free trial. After that, a license key is required.
          Licenses are delivered instantly to your email after checkout.
        </p>
        <div class="flex items-center gap-6 flex-wrap rounded-2xl border border-[rgba(0,212,255,0.25)] bg-[rgba(0,212,255,0.04)] p-6 md:p-8">
          <div>
            <p class="font-['Space_Grotesk'] font-semibold text-[28px] text-white">$49</p>
            <p class="font-['Inter'] text-[13px] text-[#94A3B8]">₵750 · one-time · perpetual license</p>
          </div>
          <AddToCartButton
            client:load
            event="buy"
            label={`Buy ${ztame.name}`}
            item={{ id: ztame.id, name: ztame.name, price: ztame.priceGhs, image: ztame.image, category: ztame.category }}
          />
        </div>
      </section>

      <!-- What It Does -->
      <section class="mt-16">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">What ZTame Does</h2>
        <div class="font-['Inter'] text-[16px] text-[#94A3B8] leading-[1.8] space-y-4">
          <p>
            ZTame detects narrow, persistent spectral peaks in your audio and applies dynamic notch filtering to reduce them — but only while they are present. Unlike broad EQ cuts that dull the entire signal, ZTame's FFT-based analysis identifies and targets specific resonances in real time, leaving the surrounding frequencies untouched.
          </p>
          <p>
            Insert ZTame on vocals to tame harsh sibilance without over-compressing. Place it on a drum bus to knock down ringing cymbal frequencies. Use it on a master bus to clean up room resonances before they reach your limiter. The per-peak detection engine works continuously, adapting to the material as it plays.
          </p>
          <p>
            <strong>ZTame vs. dynamic resonance suppressors like Soothe 3:</strong> ZTame competes in the same category of spectral dynamics processors that have become essential tools in modern mixing. It distinguishes itself with selectivity gating (how narrowly a peak must be defined before reduction engages), a configurable split-band crossover for independent low/high detection behavior, latency-aligned Dry/Wet blending, and built-in Mid/Side processing — all without requiring a separate subscription or iLok dongle.
          </p>
        </div>
      </section>

      <!-- Key Features -->
      <section class="mt-12">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">Key Features</h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            FFT-based automatic spectral peak detection and dynamic reduction
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Per-peak dynamic notch filtering — only active frequencies are reduced
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Selectivity gating for precise control over peak definition
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Configurable split-band crossover for independent low/high detection
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Stereo and Mid/Side processing modes
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            1x, 2x, and 4x oversampling for alias-free processing
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Listen mode — audition only the removed signal for precision tuning
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Latency-aligned Dry/Wet control for parallel processing
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Real-time spectrum display and gain reduction metering
          </li>
          <li class="flex items-start gap-3 font-['Inter'] text-[15px] text-[#CBD5E1]">
            <span class="text-[#00D4FF] mt-1">&#10003;</span>
            Six factory presets: Vocal Harshness Tamer, De-Boom, Guitar Resonance Smooth, Cymbal Ring Killer, Master Polish, and Podcast Clarity
          </li>
        </ul>
      </section>

      <!-- Controls Overview -->
      <section class="mt-12">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">Controls</h2>
        <div class="font-['Inter'] text-[15px] text-[#94A3B8] leading-[1.8] space-y-2">
          <p><strong class="text-[#CBD5E1]">Sensitivity</strong> — Threshold for spectral peak detection. Raise until the gain reduction meter moves on harsh resonances.</p>
          <p><strong class="text-[#CBD5E1]">Range</strong> — Maximum dynamic reduction applied to detected peaks (in dB).</p>
          <p><strong class="text-[#CBD5E1]">Selectivity</strong> — How narrowly a spectral peak must be defined before reduction engages. Higher values require sharper, more isolated peaks.</p>
          <p><strong class="text-[#CBD5E1]">Crossover</strong> — Splits the frequency spectrum into low and high bands with independent detection behavior.</p>
          <p><strong class="text-[#CBD5E1]">Attack / Release</strong> — How quickly reduction engages and recovers after a peak subsides.</p>
          <p><strong class="text-[#CBD5E1]">Listen</strong> — Outputs only the suppressed difference signal for precise auditioning.</p>
          <p><strong class="text-[#CBD5E1]">Dry/Wet</strong> — Parallel blend of latency-aligned dry and processed signals.</p>
          <p><strong class="text-[#CBD5E1]">Oversampling</strong> — Off, 2x, or 4x. Higher modes reduce aliasing at the cost of additional CPU.</p>
          <p><strong class="text-[#CBD5E1]">Mode</strong> — Stereo, M/S Blend, Mid Only, or Side Only. Mid/Side modes encode L/R into Mid/Side, process, then decode back to L/R; isolation modes process only the Mid or only the Side channel.</p>
        </div>
      </section>

      <!-- ZTame vs Manual EQ (honest comparison) -->
      <section class="mt-12">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">ZTame vs Manual EQ</h2>
        <p class="font-['Inter'] text-[15px] text-[#94A3B8] leading-[1.7] max-w-[700px] mb-6">
          ZTame does not replace EQ — they are different workflows. EQ gives you deliberate, manual
          control over any frequency. ZTame automates the identification and dynamic control of
          problematic resonances.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="rounded-xl border border-[rgba(255,255,255,0.08)] bg-[rgba(255,255,255,0.03)] p-6">
            <h3 class="font-['Space_Grotesk'] font-semibold text-[18px] text-white mb-3">Manual EQ</h3>
            <ul class="font-['Inter'] text-[14px] text-[#94A3B8] leading-[1.8] space-y-2 list-disc list-inside">
              <li>Full manual control over any frequency, at any time.</li>
              <li>You locate the problem by ear and set a static cut.</li>
              <li>A fixed cut is always applied — even when the resonance is not present.</li>
              <li>Great for creative tone-shaping and broad correction.</li>
            </ul>
          </div>
          <div class="rounded-xl border border-[rgba(0,212,255,0.18)] bg-[rgba(0,212,255,0.04)] p-6">
            <h3 class="font-['Space_Grotesk'] font-semibold text-[18px] text-white mb-3">ZTame</h3>
            <ul class="font-['Inter'] text-[14px] text-[#94A3B8] leading-[1.8] space-y-2 list-disc list-inside">
              <li>Detects narrow, persistent spectral peaks automatically.</li>
              <li>Reduces them dynamically — only while they are present.</li>
              <li>Leaves surrounding frequencies untouched, preserving tone.</li>
              <li>Ideal for repetitive cleanup of harsh resonances across a mix.</li>
            </ul>
          </div>
        </div>
        <p class="mt-4 font-['Inter'] text-[13px] text-[#64748B] max-w-[700px]">
          Most engineers use both: EQ for deliberate shaping, ZTame for dynamic resonance control.
        </p>
      </section>

      <!-- System Requirements -->
      <section class="mt-12">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">System Requirements</h2>
        <ul class="font-['Inter'] text-[15px] text-[#94A3B8] leading-[1.8] space-y-1 list-disc list-inside">
          <li>Windows 10 22H2 or later (64-bit)</li>
          <li>VST3-compatible 64-bit host (FL Studio, Ableton Live, Cubase, Reaper, Studio One, Bitwig)</li>
          <li>4 GB RAM minimum</li>
          <li>44.1 kHz – 192 kHz audio interface or session</li>
          <li>Format: VST3 only (AU and AAX not available in v1.0.0)</li>
          <li>Channels: Stereo only (no mono or multi-channel support in v1.0.0)</li>
          <li>Latency: FFT analysis latency scales with oversampling — 2048 samples at 1×, 1024 + 2×24 at 2×, 512 + 3×24 at 4× (≈22 ms in 2× mode at 44.1 kHz). Dry/Wet is latency-aligned so parallel processing stays sample-accurate.</li>
        </ul>
      </section>

      <!-- Compatibility -->
      <CompatibilitySection
        client:load
        platform={ztame.platform}
        format={ztame.format}
        osNote="Windows 10 22H2 or later (64-bit)"
      />

      <!-- FAQ -->
      <section class="mt-12">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">Frequently Asked Questions</h2>
        <div class="space-y-6 font-['Inter']">
          <div>
            <h3 class="text-[16px] font-semibold text-white mb-1">Does ZTame support AU or AAX formats?</h3>
            <p class="text-[15px] text-[#94A3B8] leading-[1.7]">No. ZTame version 1.0.0 is Windows VST3 only. AU (macOS) and AAX (Pro Tools) support may be considered for future releases based on customer demand.</p>
          </div>
          <div>
            <h3 class="text-[16px] font-semibold text-white mb-1">How does ZTame compare to Soothe 3?</h3>
            <p class="text-[15px] text-[#94A3B8] leading-[1.7]">ZTame is a dynamic resonance suppressor in the same category as Soothe 3, DSEQ3, and similar spectral dynamics processors. ZTame offers selectivity gating, split-band crossover detection, latency-aligned Dry/Wet, and Mid/Side processing at a competitive $49 price point with no subscription required. The right choice depends on your workflow — we recommend trying both to see which detection behavior fits your material.</p>
          </div>
          <div>
            <h3 class="text-[16px] font-semibold text-white mb-1">Can I use ZTame on mono tracks?</h3>
            <p class="text-[15px] text-[#94A3B8] leading-[1.7]">No. ZTame version 1.0.0 is a stereo-only processor. Its FFT engine, spectral detection, and Mid/Side modes require a stereo bus, so it is intended for stereo tracks and buses. If you need mono processing, use it on a stereo bus instead.</p>
          </div>
          <div>
            <h3 class="text-[16px] font-semibold text-white mb-1">Is there a free trial?</h3>
            <p class="text-[15px] text-[#94A3B8] leading-[1.7]">Yes. ZTame includes a 14-day fully functional trial. After the trial, a perpetual license costs $49 (₵750) — a one-time purchase with no subscriptions, dongles, or iLok.</p>
          </div>
          <div>
            <h3 class="text-[16px] font-semibold text-white mb-1">What if ZTame uses too much CPU?</h3>
            <p class="text-[15px] text-[#94A3B8] leading-[1.7]">Select Off or 2x oversampling (instead of 4x) and increase your audio buffer size. The FFT analysis engine scales with oversampling level and buffer size.</p>
          </div>
        </div>
      </section>

      <!-- Changelog -->
      <section class="mt-12">
        <h2 class="font-['Space_Grotesk'] font-semibold text-[28px] text-white mb-4">Changelog</h2>
        <div class="font-['Inter'] text-[15px] text-[#94A3B8] leading-[1.8]">
          <h3 class="text-[16px] font-semibold text-white mb-2">1.0.0 — Initial Release</h3>
          <ul class="list-disc list-inside space-y-1">
            <li>Dynamic spectral resonance suppression with FFT-based peak detection</li>
            <li>Stereo and Mid/Side processing modes (Stereo, M/S Blend, Mid Only, Side Only)</li>
            <li>1x, 2x, and 4x oversampling</li>
            <li>Latency-aligned Dry/Wet control and Listen mode</li>
            <li>Six factory presets: Vocal Harshness Tamer, De-Boom, Guitar Resonance Smooth, Cymbal Ring Killer, Master Polish, Podcast Clarity</li>
            <li>Real-time spectrum display and gain reduction metering</li>
          </ul>
        </div>
