---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FactoryApp from '../../components/factory/FactoryApp';
---

<BaseLayout
  title="Zarlino Plugin Factory — describe a plugin, download a Windows VST3"
  description="Turn plain English into a real Windows VST3. Zarlino assembles your processor from its certified DSP modules, shows you the exact plan, and builds and validates it in the cloud."
  canonicalURL="https://zarlinoaudio.com/factory/"
>
  <main class="relative z-[1] bg-[#050505] min-h-screen pt-24 pb-24 px-6 md:px-10">
    <div class="max-w-[1100px] mx-auto">
      <nav class="mb-8 font-['Inter'] text-[13px] text-[#64748B]">
        <a href="/" class="hover:text-white transition-colors">Zarlino Audio</a>
        <span class="mx-2">/</span>
        <span class="text-[#94A3B8]">Plugin Factory</span>
      </nav>

      <FactoryApp client:load />

      <section class="mt-16 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-[rgba(255,255,255,0.08)] bg-[rgba(255,255,255,0.02)] p-5">
          <h2 class="font-['Space_Grotesk'] text-[15px] font-semibold text-white">Built from certified modules</h2>
          <p class="mt-2 font-['Inter'] text-[12px] leading-[1.8] text-[#94A3B8]">
            Every processor is assembled from Zarlino's own shipped DSP — EQ, compressor, gate, saturation,
            limiter, transient shaper, stereo tools. No generated code, no invented algorithms.
          </p>
        </div>
        <div class="rounded-2xl border border-[rgba(255,255,255,0.08)] bg-[rgba(255,255,255,0.02)] p-5">
          <h2 class="font-['Space_Grotesk'] text-[15px] font-semibold text-white">Quality checked before you get it</h2>
          <p class="mt-2 font-['Inter'] text-[12px] leading-[1.8] text-[#94A3B8]">
            Each build runs an automated gate: silence, impulse, extreme settings, six sample rates, eight buffer
            sizes, bypass, state restore, latency and CPU. A build that fails the gate is never downloadable.
          </p>
        </div>
        <div class="rounded-2xl border border-[rgba(255,255,255,0.08)] bg-[rgba(255,255,255,0.02)] p-5">
          <h2 class="font-['Space_Grotesk'] text-[15px] font-semibold text-white">Honest about limits</h2>
          <p class="mt-2 font-['Inter'] text-[12px] leading-[1.8] text-[#94A3B8]">
            Reverbs, delays, instruments and amp simulations aren't in the certified set yet. If your idea needs one,
            Zarlino says so and offers the closest thing it can actually build — it never fakes it.
          </p>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
