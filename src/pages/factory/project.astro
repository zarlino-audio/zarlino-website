---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FactoryProject from '../../components/factory/FactoryProject';
---

<BaseLayout
  title="Plugin Factory — project — Zarlino Audio"
  description="Describe, review, refine and build your Windows VST3."
  canonicalURL="https://zarlinoaudio.com/factory/project/"
  noindex
>
  <main class="relative z-[1] bg-[#050505] min-h-screen pt-24 pb-24 px-6 md:px-10">
    <div class="max-w-[1100px] mx-auto">
      {/* The island reads ?id= itself, so the page needs no server rendering
          and the id is never interpolated into markup. */}
      <FactoryProject client:only="react" />
    </div>
  </main>
</BaseLayout>
