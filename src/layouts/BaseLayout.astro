---
import '../index.css';
import AppShell from '../components/AppShell';
import Footer from '../sections/Footer';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
  schemaType?: string;
  noindex?: boolean;
}
const {
  title,
  description,
  ogImage = '/images/og-image.png',
  canonicalURL,
  schemaType,
  noindex = false
} = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050505" />
    <meta name="generator" content="Astro" />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="mask-icon" href="/images/favicon.svg" color="#00D4FF" />

    <!-- Robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Zarlino Audio" />
    <meta name="application-name" content="Zarlino Audio" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="keywords" content="Zarlino Audio, ZTame, ZScorch, resonance suppressor, audio plugin, VST3, harmonic processor, mixing, mastering, Windows plugin" />

    <!-- Canonical -->
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={schemaType || 'website'} />
    <meta property="og:url" content={canonicalURL || 'https://zarlinoaudio.com'} />
    <meta property="og:image" content={`https://zarlinoaudio.com${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Zarlino Audio" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@zarlinoaudio" />
    <meta name="twitter:creator" content="@zarlinoaudio" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`https://zarlinoaudio.com${ogImage}`} />

    <!-- Fonts: non-render-blocking (fallback text paints first, fonts swap in).
         `display=swap` is already in the URL; the media="print" trick defers the
         stylesheet so first paint isn't gated on the Google Fonts round-trip. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      />
    </noscript>

    <!-- SEO: hint crawlers about key pages -->
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <AppShell client:load />
    <slot />
    <Footer />

    <!-- Page-view beacon for the /admin dashboard (no-op if KV is not bound) -->
    <script is:inline>
      (function () {
        try {
          var p = window.location.pathname;
          if (p === '/admin' || p.startsWith('/api/')) return;
          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/track', new Blob([JSON.stringify({ path: p })], { type: 'application/json' }));
          } else {
            fetch('/api/track', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ path: p }),
              keepalive: true,
            });
          }
        } catch (e) {}
      })();
    </script>
  </body>
</html>
