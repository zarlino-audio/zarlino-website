---
import '../index.css';
import AppShell from '../components/AppShell';
import Footer from '../sections/Footer';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
  schemaType?: string;
  noindex?: boolean;
}
const {
  title,
  description,
  ogImage = '/images/zarlino-logo.svg',
  canonicalURL,
  schemaType,
  noindex = false
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical -->
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={schemaType || 'website'} />
    <meta property="og:url" content={canonicalURL || 'https://zarlinoaudio.com'} />
    <meta property="og:image" content={`https://zarlinoaudio.com${ogImage}`} />
    <meta property="og:site_name" content="Zarlino Audio" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`https://zarlinoaudio.com${ogImage}`} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <AppShell client:load />
    <slot />
    <Footer client:load />

    <!-- Page-view beacon for the /admin dashboard (no-op if KV is not bound) -->
    <script is:inline>
      (function () {
        try {
          var p = window.location.pathname;
          if (p === '/admin' || p.startsWith('/api/')) return;
          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/track', new Blob([JSON.stringify({ path: p })], { type: 'application/json' }));
          } else {
            fetch('/api/track', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ path: p }),
              keepalive: true,
            });
          }
        } catch (e) {}
      })();
    </script>
  </body>
</html>
